backend/venv/
__pycache__/
*.pyc
.DS_Store
.uvicorn-test.log

# Model artifacts are committed (the extension needs them at runtime),
# but training scratch is not.
training/model/metrics.json

# Downloaded corpus archives. build_corpus.py re-fetches them on demand;
# dataset.csv is the committed, redacted output.
training/corpus-cache/

# Store upload zips. tools/package.py rebuilds them byte-identically from any
# commit, so committing one would only ever go stale.
dist/

# Agent worktrees are transient, and each is its own git repo.
.claude/worktrees/

# Chrome for Testing, fetched on demand by
# `npx @puppeteer/browsers install chrome@stable` per tests/run_all.py's own
# instructions — not something to commit.
/chrome/
